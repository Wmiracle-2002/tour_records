FOOTMARKS_DATABASE_URL=sqlite:///./data/footmarks.db
FOOTMARKS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Used once by python -m app.bootstrap; remove after initialization.
# FOOTMARKS_INITIAL_USERNAME=shared
# FOOTMARKS_INITIAL_PASSWORD=replace-with-a-private-password-at-least-12-characters

# 高德 Web 服务 API Key，只填后端服务器的 server/.env，不要提交到 Git。
# FOOTMARKS_AMAP_WEB_KEY=replace-with-your-amap-web-service-key
FOOTMARKS_AMAP_BASE_URL=https://restapi.amap.com
FOOTMARKS_AMAP_TIMEOUT_SECONDS=10
