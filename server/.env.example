FOOTMARKS_DATABASE_URL=sqlite:///./data/footmarks.db
FOOTMARKS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Used once by python -m app.bootstrap; remove after initialization.
# FOOTMARKS_INITIAL_USERNAME=shared
# FOOTMARKS_INITIAL_PASSWORD=replace-with-a-private-password-at-least-12-characters

# Tencent Cloud COS. Leave the credential fields empty to disable image storage locally.
FOOTMARKS_COS_BUCKET=footmark-1489262329
FOOTMARKS_COS_REGION=ap-hongkong
FOOTMARKS_COS_DOMAIN=https://footmark-1489262329.cos.ap-hongkong.myqcloud.com
# FOOTMARKS_COS_SECRET_ID=replace-with-a-cam-subaccount-secret-id
# FOOTMARKS_COS_SECRET_KEY=replace-with-a-cam-subaccount-secret-key
# FOOTMARKS_COS_SESSION_TOKEN=
FOOTMARKS_COS_URL_EXPIRE_SECONDS=3600
